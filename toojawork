<!DOCTYPE html>

<html lang="ko">
<head>
<meta charset="utf-8"/><meta content="width=device-width,initial-scale=1" name="viewport"/>
<title>투자의 연습 | 가상 주식 투자</title>
<style>
:root{--navy:#152642;--blue:#4169e1;--bg:#f4f7fc;--muted:#697991;--up:#e44a62;--down:#2878df;--line:#e4eaf2}*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,"Malgun Gothic",sans-serif;color:var(--navy)}button,input{font:inherit}button{cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}.top{background:#fff;border-bottom:1px solid var(--line)}.nav{max-width:1100px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:18px 20px;gap:12px}.brand{font-size:21px;font-weight:850;letter-spacing:-.7px}.brand span{color:var(--blue)}.tag{background:#edf2ff;color:#4261c7;border-radius:20px;padding:7px 12px;font-size:12px;font-weight:700}.wrap{max-width:1100px;margin:auto;padding:28px 20px 65px}.hero{background:linear-gradient(120deg,#172e57,#4269c7);color:#fff;border-radius:22px;padding:32px;margin-bottom:22px}.hero h1{font-size:30px;letter-spacing:-1px;margin:0 0 10px}.hero p{opacity:.87;margin:0;line-height:1.7}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:20px 0}.card{background:white;border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 5px 22px #21335a08}.stat-label,.muted{color:var(--muted);font-size:13px}.stat-value{font-size:25px;font-weight:800;margin-top:12px;letter-spacing:-.7px;overflow-wrap:anywhere}.up{color:var(--up)}.down{color:var(--down)}.layout{display:grid;grid-template-columns:1.2fr .8fr;gap:18px}.section-title{font-size:18px;margin:0 0 18px}.stock{width:100%;display:flex;justify-content:space-between;align-items:center;text-align:left;padding:16px;border:1px solid var(--line);background:white;border-radius:12px;margin:10px 0;gap:12px}.stock.active{border:2px solid var(--blue);background:#f6f8ff;padding:15px}.stock strong{display:block;font-size:15px}.stock small{display:block;color:var(--muted);margin-top:5px}.stock-price{text-align:right;white-space:nowrap;font-weight:750}.stock-price small{font-size:12px}.button{border:0;background:var(--blue);color:white;border-radius:11px;padding:13px 17px;font-weight:750}.button.secondary{background:#eaf0ff;color:#3156bf}.button.danger{background:#fff0f2;color:#c83751}.button.full{width:100%}.button-row{display:flex;gap:9px;margin-top:12px}.button-row>*{flex:1}.field{display:block;margin:18px 0 8px;font-size:14px;font-weight:700}input{width:100%;border:1px solid #cdd7e6;border-radius:10px;padding:13px;background:#fff}input:focus,button:focus-visible{outline:3px solid #a6baff;outline-offset:2px}.selected{background:#f3f6ff;border-radius:13px;padding:17px}.selected h3{margin:0 0 8px}.selected .big{font-size:26px;font-weight:800}.info{display:flex;justify-content:space-between;gap:12px;margin:12px 0;font-size:14px}.info strong{text-align:right}.notice{font-size:13px;color:var(--muted);line-height:1.65}.feedback{min-height:24px;font-size:13px;font-weight:650}.divider{height:1px;background:var(--line);margin:20px 0}.holding{border-bottom:1px solid var(--line);padding:14px 0}.holding:last-child{border-bottom:0}.holding-head{display:flex;justify-content:space-between;gap:12px}.holding small{display:block;color:var(--muted);margin-top:5px}.history{max-height:270px;overflow:auto}.history-item{padding:11px 0;border-bottom:1px solid var(--line);font-size:13px}.history-item:last-child{border:0}.footer{color:var(--muted);font-size:12px;line-height:1.7;text-align:center;margin-top:25px}.mini{font-size:12px;color:var(--muted)}@media(max-width:850px){.stats{grid-template-columns:repeat(2,1fr)}.layout{grid-template-columns:1fr}}@media(max-width:480px){.wrap{padding:18px 12px 40px}.hero{padding:24px 20px}.hero h1{font-size:25px}.card{padding:17px}.stat-value{font-size:20px}.tag{font-size:11px}.brand{font-size:18px}}

/* 숨겨진 캐릭터 이스터에그 */
.brand{cursor:pointer;user-select:none}.egg-overlay{position:fixed;inset:0;background:#0b1736c9;z-index:999;display:flex;align-items:center;justify-content:center;padding:20px}.egg-overlay[hidden]{display:none}.egg-panel{background:white;border-radius:22px;max-width:570px;width:100%;padding:18px;box-shadow:0 24px 80px #0005;text-align:center;position:relative;animation:egg-pop .25s ease-out}.egg-panel img{width:100%;max-height:65vh;object-fit:contain;border-radius:14px}.egg-panel h2{margin:10px 0 5px;font-size:22px}.egg-panel p{color:#697991;margin:0 0 14px}.egg-close{position:absolute;right:25px;top:25px;background:#fff;color:#152642;border:0;border-radius:50%;width:36px;height:36px;font-size:22px;box-shadow:0 2px 10px #0003}@keyframes egg-pop{from{transform:scale(.88);opacity:0}to{transform:scale(1);opacity:1}}

/* 숨겨진 캐릭터 이스터 에그 */
.brand{cursor:pointer;user-select:none}.egg-overlay[hidden]{display:none}.egg-overlay{position:fixed;inset:0;z-index:9999;background:rgba(12,20,39,.78);display:flex;align-items:center;justify-content:center;padding:20px}.egg-panel{position:relative;width:min(520px,100%);background:#fff;border-radius:22px;padding:16px;box-shadow:0 20px 70px #0005;text-align:center;animation:egg-pop .25s ease-out}.egg-panel img{display:block;width:100%;height:auto;border-radius:13px}.egg-panel h2{margin:15px 0 5px}.egg-panel p{margin:0 0 10px;color:#697991;font-size:14px}.egg-close{position:absolute;right:22px;top:22px;border:0;border-radius:50%;background:#fff;color:#172e57;width:36px;height:36px;font-size:23px;box-shadow:0 2px 8px #0004}@keyframes egg-pop{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}
</style>
</head>
<body>
<header class="top"><div class="nav"><div aria-label="투자의 연습 로고" class="brand" id="secretBrand" role="button" tabindex="0">📈 <span>투자의 연습</span></div><span class="tag">가상 투자 · 교육용</span></div></header>
<main class="wrap">
<section class="hero"><h1>실전처럼 연습하고,<br/>안전하게 배워요.</h1><p>가상 자금 100만 원으로 시작하는 나만의 주식 투자 연습장.<br/>종목을 고르고, 매수하고, 주가 변화에 따른 수익을 확인해 보세요.</p></section>
<section aria-label="내 자산 현황" class="stats"><div class="card"><div class="stat-label">총 자산</div><div class="stat-value" id="total">-</div></div><div class="card"><div class="stat-label">보유 현금</div><div class="stat-value" id="cash">-</div></div><div class="card"><div class="stat-label">주식 평가금</div><div class="stat-value" id="invested">-</div></div><div class="card"><div class="stat-label">전체 수익률</div><div class="stat-value" id="return">-</div></div></section>
<div class="layout"><div><section class="card"><h2 class="section-title">🏢 가상 주식 시장</h2><p class="notice">종목을 선택한 뒤 투자해 보세요. 아래 가격은 실제 주가가 아닌 시뮬레이션용 숫자입니다.</p><div id="stocks"></div><button class="button secondary full" id="nextDay">🎲 다음 거래일로 이동 · 주가 변동</button><div class="info"><span class="muted">현재 시뮬레이션</span><strong id="day"></strong></div></section><section class="card" style="margin-top:18px"><h2 class="section-title">💼 내 보유 주식</h2><div id="holdings"></div></section></div>
<div><section class="card"><h2 class="section-title">💸 주식 거래하기</h2><div class="selected"><h3 id="selectedName"></h3><div class="big" id="selectedPrice"></div><div class="info"><span>현재 보유 수량</span><strong id="owned"></strong></div></div><label class="field" for="quantity">거래 수량 (주)</label><input id="quantity" inputmode="numeric" min="1" step="1" type="number" value="1"/><div class="info"><span>예상 거래 금액</span><strong id="cost"></strong></div><div class="button-row"><button class="button" id="buy">매수하기</button><button class="button secondary" id="sell">매도하기</button></div><p aria-live="polite" class="feedback" id="feedback" role="status"></p><p class="notice">매수는 보유 현금 범위 내에서만, 매도는 보유 주식 수량 내에서만 가능합니다. 수수료와 세금은 적용하지 않습니다.</p></section><section class="card" style="margin-top:18px"><h2 class="section-title">🧾 거래 기록</h2><div class="history" id="history"></div><div class="divider"></div><button class="button danger full" id="reset">↺ 투자 연습 초기화</button></section></div></div>
<p class="footer">이 서비스는 금융 교육용 가상 시뮬레이터입니다. 실제 증권 거래, 투자 추천, 미래 가격 예측 기능을 제공하지 않습니다.<br/>기록은 사용 중인 브라우저의 로컬 저장소에만 보관됩니다.</p>
</main>
<div class="egg-overlay" hidden="" id="eggOverlay"><div aria-labelledby="eggTitle" aria-modal="true" class="egg-panel" role="dialog"><button aria-label="닫기" class="egg-close" id="eggClose" type="button">×</button><h2 id="eggTitle">🎉 비밀 캐릭터 발견!</h2><p id="eggMessage">투자 연습 중 숨겨진 친구들을 찾았어요 🐮🐆</p><img alt="노을 아래 서 있는 노란 소, 주황색 소, 노란 표범 캐릭터" src="data:image/png;base64,"/><button class="button full" id="eggDone" type="button">연습 계속하기</button></div></div>

<script>
 'use strict';
let eggClicks=0, eggLast=0;
const eggOverlay=document.getElementById('eggOverlay');
const eggBrand=document.getElementById('secretBrand');
const eggClose=document.getElementById('eggClose');
function hideEgg(){eggOverlay.hidden=true;document.body.style.overflow='';eggBrand.focus()}
function openEgg(){eggOverlay.hidden=false;document.body.style.overflow='hidden';eggClose.focus()}
function revealEgg(){const now=Date.now();eggClicks=(now-eggLast>2500)?1:eggClicks+1;eggLast=now;if(eggClicks>=5){eggClicks=0;$('eggTitle').textContent='🎉 비밀 캐릭터 발견!';$('eggMessage').textContent='투자 연습 중 숨겨진 친구들을 찾았어요 🐮🐆';openEgg()}}
eggBrand.addEventListener('click',revealEgg);
eggBrand.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();revealEgg()}});
eggClose.addEventListener('click',hideEgg);
document.getElementById('eggDone').addEventListener('click',hideEgg);
eggOverlay.addEventListener('click',e=>{if(e.target===eggOverlay)hideEgg()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!eggOverlay.hidden)hideEgg()});

let lastReaction='neutral';
const KEY='investment_practice_v1',START=1000000;
const base=[{id:'tech',name:'미래테크',sector:'기술',price:58000},{id:'green',name:'그린에너지',sector:'친환경',price:32500},{id:'food',name:'행복푸드',sector:'식품',price:18400},{id:'bio',name:'바이오스타',sector:'바이오',price:76500}];
const $=id=>document.getElementById(id),won=n=>Math.round(n).toLocaleString('ko-KR')+'원';
function fresh(){return {cash:START,day:1,stocks:base.map(s=>({...s})),holdings:{},history:[]}};
function load(){try{const s=JSON.parse(localStorage.getItem(KEY));if(!s||!Number.isInteger(s.day)||s.day<1||!Number.isSafeInteger(s.cash)||s.cash<0||!Array.isArray(s.stocks)||s.stocks.length!==base.length||!s.stocks.every((x,i)=>x.id===base[i].id&&Number.isSafeInteger(x.price)&&x.price>0)||!s.holdings||typeof s.holdings!=='object'||!base.every(b=>{const h=s.holdings[b.id];return !h||(Number.isSafeInteger(h.qty)&&h.qty>=0&&Number.isSafeInteger(h.cost)&&h.cost>=0)})||!Array.isArray(s.history))return fresh();return s}catch{return fresh()}};
let state=load(),selected=base[0].id;
function persist(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch{feedback('저장 공간이 부족하거나 차단되어 기록을 저장하지 못했어요.',true)}}
function feedback(msg,error=false){$('feedback').textContent=msg;$('feedback').style.color=error?'#c83751':'#13856d'}
function current(){return state.stocks.find(s=>s.id===selected)}
function owned(id){return state.holdings[id]?.qty||0}
function quantity(){const raw=$('quantity').value.trim(),n=Number(raw);return raw!==''&&Number.isSafeInteger(n)&&n>0&&n<=1000000?n:null}
function render(){const stockValue=state.stocks.reduce((sum,s)=>sum+s.price*owned(s.id),0),total=state.cash+stockValue,profit=total-START,rate=profit/START*100;$('total').textContent=won(total);$('cash').textContent=won(state.cash);$('invested').textContent=won(stockValue);$('return').textContent=(profit>0?'+':'')+rate.toFixed(2)+'%';$('return').className='stat-value '+(profit>0?'up':profit<0?'down':'');$('day').textContent=state.day+'일 차';
const list=$('stocks');list.replaceChildren();state.stocks.forEach(s=>{const b=document.createElement('button');b.className='stock'+(s.id===selected?' active':'');b.type='button';b.setAttribute('aria-pressed',String(s.id===selected));const left=document.createElement('div'),name=document.createElement('strong'),sector=document.createElement('small');name.textContent=s.name;sector.textContent=s.sector+' · 가상 종목';left.append(name,sector);const right=document.createElement('div');right.className='stock-price';right.textContent=won(s.price);b.append(left,right);b.onclick=()=>{selected=s.id;feedback('');render()};list.append(b)});
const s=current();$('selectedName').textContent=s.name;$('selectedPrice').textContent=won(s.price);$('owned').textContent=owned(s.id).toLocaleString('ko-KR')+'주';const q=quantity();$('cost').textContent=q?won(q*s.price):'올바른 수량을 입력하세요';
const holdings=$('holdings');holdings.replaceChildren();let any=false;state.stocks.forEach(x=>{const h=state.holdings[x.id];if(!h||h.qty===0)return;any=true;const value=x.price*h.qty,profit=value-h.cost,percent=h.cost>0?profit/h.cost*100:0;const item=document.createElement('div');item.className='holding';const head=document.createElement('div');head.className='holding-head';const a=document.createElement('strong');a.textContent=x.name+' · '+h.qty+'주';const b=document.createElement('strong');b.textContent=won(value);head.append(a,b);const detail=document.createElement('small');detail.textContent='평가손익 '+(profit>0?'+':'')+won(profit)+' ('+(percent>0?'+':'')+percent.toFixed(2)+'%)';detail.className=profit>0?'up':profit<0?'down':'muted';item.append(head,detail);holdings.append(item)});if(!any){const p=document.createElement('p');p.className='notice';p.textContent='아직 보유한 주식이 없어요. 첫 주식을 매수해 보세요!';holdings.append(p)}
const history=$('history');history.replaceChildren();if(!state.history.length){const p=document.createElement('p');p.className='notice';p.textContent='거래 내역이 없습니다.';history.append(p)}else state.history.slice().reverse().slice(0,50).forEach(h=>{const row=document.createElement('div');row.className='history-item';row.textContent=h.day+'일 차 · '+h.action+' · '+h.name+' '+h.qty+'주 · '+won(h.amount);history.append(row)})}
function trade(action){const q=quantity(),s=current();if(q===null){feedback('거래 수량은 1~1,000,000 사이의 정수로 입력해 주세요.',true);return}const amount=q*s.price;if(!Number.isSafeInteger(amount)){feedback('거래 금액이 너무 큽니다.',true);return}if(action==='매수'&&amount>state.cash){feedback('현금이 부족합니다. 수량을 줄여 주세요.',true);return}if(action==='매도'&&q>owned(s.id)){feedback('보유 주식 수량이 부족합니다.',true);return}const h=state.holdings[s.id]||{qty:0,cost:0};if(action==='매수'){state.cash-=amount;h.qty+=q;h.cost+=amount}else{const remaining=h.qty-q;h.cost=remaining===0?0:Math.round(h.cost*remaining/h.qty);h.qty=remaining;state.cash+=amount}state.holdings[s.id]=h;state.history.push({day:state.day,action,name:s.name,qty:q,amount});persist();render();feedback('✓ '+s.name+' '+q+'주 '+action+' 완료!')}
$('buy').onclick=()=>trade('매수');$('sell').onclick=()=>trade('매도');$('quantity').addEventListener('input',()=>{const q=quantity();$('cost').textContent=q?won(q*current().price):'올바른 수량을 입력하세요'});
$('nextDay').onclick=()=>{state.day++;state.stocks.forEach(s=>{const change=(Math.random()*0.16)-0.08;s.price=Math.max(100,Math.round(s.price*(1+change)/100)*100)});persist();render();feedback('📊 '+state.day+'일 차 주가가 새롭게 반영되었습니다.');showInvestmentReaction()};
$('reset').onclick=()=>{if(!confirm('모든 보유 주식과 거래 기록을 삭제하고 가상 자금 100만 원부터 다시 시작할까요?'))return;state=fresh();lastReaction='neutral';selected=base[0].id;$('quantity').value=1;persist();render();feedback('투자 연습을 처음부터 다시 시작합니다.')};render();


// 전체 자산 손익이 3만 원 이상 상승/하락하면 캐릭터가 반응합니다.
function showInvestmentReaction(){
 const value=state.cash+state.stocks.reduce((sum,s)=>sum+s.price*owned(s.id),0);
 const profit=value-START;
 const mood=profit>=30000?'win':profit<=-30000?'loss':'neutral';
 if(mood==='neutral'){lastReaction='neutral';return;}
 if(mood===lastReaction)return;
 lastReaction=mood;
 if(mood==='win'){
  $('eggTitle').textContent='🎉 캐릭터들이 수익을 축하해요!';
  $('eggMessage').textContent='현재 총 평가손익 '+(profit>=0?'+':'')+won(profit)+'! 잘했어요! 하지만 투자 수익은 항상 보장되지 않아요.';
 }else{
  $('eggTitle').textContent='🐮 괜찮아, 투자도 연습이야!';
  $('eggMessage').textContent='현재 총 평가손익 '+won(profit)+'이에요. 손실이 나는 이유를 살펴보고, 다음에는 분산투자도 연습해 봐요.';
 }
 openEgg();
}
</script>
</body></html>
